# Broker remote defaults (used when running broker-remote standalone)
BROKER_DRIVER=memory
BROKER_WS_URL=ws://127.0.0.1:7777/ws
BROKER_HTTP_URL=http://127.0.0.1:7777
BROKER_RING_BUFFER_SIZE=100

# Host-shell runtime broker config
VITE_BROKER_DRIVER=memory
VITE_BROKER_WS_URL=ws://127.0.0.1:7777/ws
VITE_BROKER_HTTP_URL=http://127.0.0.1:7777
VITE_BROKER_RING_BUFFER_SIZE=100

# Durable server
PORT=7777
BROKER_DB_PATH=./federated-kafka.sqlite
